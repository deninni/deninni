# plantOS – alle Werte optional. Ohne Env läuft alles lokal (Demo-Engine, Datei-Store).

# HMAC-Schlüssel für Session-Cookies. In jedem Pilot/Produktivbetrieb PFLICHT (min. 32 Zeichen).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PLANTOS_SESSION_SECRET=

# Session-Dauer in Stunden (Default 12 = eine Schicht + Übergabe)
PLANTOS_SESSION_HOURS=12

# Token für Edge-Agenten (Header: Authorization: Bearer <token>). Ohne Token: nur mit Session.
PLANTOS_EDGE_TOKEN=

# Datenverzeichnis (Default ./data)
PLANTOS_DATA_DIR=

# Demo-Passwörter überschreiben (Default siehe README)
PLANTOS_DEMO_PASSWORD=
