# plantOS – alle Werte optional. Ohne Env läuft alles lokal (Demo-Engine, Datei-Store).

# HMAC-Schlüssel für Session-Cookies. In jedem Pilot/Produktivbetrieb PFLICHT (min. 32 Zeichen).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PLANTOS_SESSION_SECRET=

# Session-Dauer in Stunden (Default 12 = eine Schicht + Übergabe)
PLANTOS_SESSION_HOURS=12

# Token für Edge-Agenten (Header: Authorization: Bearer <token>). Ohne Token: nur mit Session.
PLANTOS_EDGE_TOKEN=

# Datenverzeichnis (Default ./data)
PLANTOS_DATA_DIR=

# Demo-Passwörter überschreiben (Default siehe README)
PLANTOS_DEMO_PASSWORD=

# ── SSO / OIDC (Microsoft Entra ID) – implementiert, ohne Werte deaktiviert ──
# Issuer z. B. https://login.microsoftonline.com/<azure-tenant-id>/v2.0
PLANTOS_OIDC_ISSUER=
PLANTOS_OIDC_CLIENT_ID=
PLANTOS_OIDC_CLIENT_SECRET=
PLANTOS_OIDC_REDIRECT_URI=https://<host>/api/auth/oidc/callback
# Gruppen-/App-Rollen-ID → plantOS-Rolle (viewer|operator|maintenance|plant_manager|admin)
PLANTOS_OIDC_ROLE_MAP={"<gruppen-id>":"plant_manager"}
# Rolle ohne Gruppentreffer (leer = Zugriff verweigern)
PLANTOS_OIDC_DEFAULT_ROLE=
# plantOS-Mandant für SSO-Benutzer
PLANTOS_OIDC_PLANTOS_TENANT=demo

# ── SAP S/4HANA OData – implementiert, kundenseitig nicht validiert ──
PLANTOS_SAP_BASE_URL=
PLANTOS_SAP_USER=
PLANTOS_SAP_PASSWORD=
PLANTOS_SAP_CLIENT=
# Schreiben (Instandhaltungsmeldung) nur mit true UND Vier-Augen-Freigabe in plantOS
PLANTOS_SAP_WRITE_ENABLED=false

# Jedes Secret kann auch als Datei übergeben werden: <NAME>_FILE=/run/secrets/<name>
